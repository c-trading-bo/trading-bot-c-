{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "TradingBot.UnifiedOrchestrator.Scheduling": "Information",
      "TradingBot.UnifiedOrchestrator.Training": "Information",
      "TradingBot.UnifiedOrchestrator.Services.EnhancedBacktestLearningService": "Information",
      "System": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss ",
        "UseUtcTimestamp": false
      }
    }
  },
  "LabMode": {
    "QuietStartup": true,
    "ShowProgressBar": true,
    "ShowSchedulerStatus": true,
    "SuppressServiceRegistrations": true,
    "LogToFile": true,
    "LogDirectory": "logs/lab"
  }
}
