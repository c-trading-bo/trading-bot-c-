# =============================================================================
# Data Retention & Cleanup Configuration
# =============================================================================
# Controls how long various data types are kept before automatic cleanup
# DataRetentionService runs daily at 3:00 AM to prevent bloat
# See DATA_RETENTION_CONFIG.md for detailed documentation

# Promotion Records (audit trail for model promotions)
# Default: 90 days (compliance requirement)
# Recommended: 90 days (prod), 30 days (dev)
PROMOTION_RETENTION_DAYS=90

# Training Checkpoints (crash recovery for interrupted training)
# Default: 30 days
# Recommended: 30 days (Lab mode), 7 days (Terminal mode)
CHECKPOINT_RETENTION_DAYS=30

# Training Artifacts (manifests, summaries, reports)
# Default: 14 days
# Recommended: 14 days (prod), 7 days (dev)
TRAINING_ARTIFACT_RETENTION_DAYS=14

# Model Versions to Keep (per algorithm, plus current champion)
# Default: 10 versions
# Recommended: 10 (prod), 5 (dev)
MODEL_VERSIONS_TO_KEEP=10

# Temp Files (.tmp, .lock, .staging)
# Default: 24 hours
# Recommended: 24 hours (safe for all modes)
TEMP_FILE_RETENTION_HOURS=24

# Experience Files (Terminal trading experiences)
# Default: 90 days
# Recommended: 90 days (matches Lab training window)
EXPERIENCE_RETENTION_DAYS=90

# Live Training Data (JSONL files from Terminal)
# Default: 7 days
# Recommended: 7 days (prod), 3 days (dev)
LIVE_TRAINING_DATA_RETENTION_DAYS=7

# Session Backups (position state recovery)
# Default: 30 days
# Recommended: 30 days (prod), 14 days (dev)
SESSION_BACKUP_RETENTION_DAYS=30

# =============================================================================
# Example Configurations by Environment
# =============================================================================

# --- Development Environment (Limited Disk Space) ---
# PROMOTION_RETENTION_DAYS=30
# CHECKPOINT_RETENTION_DAYS=14
# TRAINING_ARTIFACT_RETENTION_DAYS=7
# MODEL_VERSIONS_TO_KEEP=5
# TEMP_FILE_RETENTION_HOURS=12
# EXPERIENCE_RETENTION_DAYS=30
# LIVE_TRAINING_DATA_RETENTION_DAYS=3
# SESSION_BACKUP_RETENTION_DAYS=14

# --- Production Lab Mode (Weekly Training) ---
# PROMOTION_RETENTION_DAYS=90
# CHECKPOINT_RETENTION_DAYS=30
# TRAINING_ARTIFACT_RETENTION_DAYS=14
# MODEL_VERSIONS_TO_KEEP=10
# TEMP_FILE_RETENTION_HOURS=24
# EXPERIENCE_RETENTION_DAYS=90
# LIVE_TRAINING_DATA_RETENTION_DAYS=7
# SESSION_BACKUP_RETENTION_DAYS=30

# --- Production Terminal Mode (Minimal Accumulation) ---
# PROMOTION_RETENTION_DAYS=90
# CHECKPOINT_RETENTION_DAYS=7
# TRAINING_ARTIFACT_RETENTION_DAYS=7
# MODEL_VERSIONS_TO_KEEP=5
# TEMP_FILE_RETENTION_HOURS=24
# EXPERIENCE_RETENTION_DAYS=90
# LIVE_TRAINING_DATA_RETENTION_DAYS=7
# SESSION_BACKUP_RETENTION_DAYS=14
